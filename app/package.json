{
  "name": "ymusic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "YMusic — Spotify-style YouTube music player (React + zero-dependency Node server)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"client/**/*.test.ts\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "~5.9.3"
  }
}
